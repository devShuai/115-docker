# Build the complete local project. Do not set an upstream application image here.
IMAGE_115=115-browser-local:36.0.1
# To deploy CI output with compose.registry.yaml instead:
# IMAGE_115=registry.devshuai.com/shuai-repo/115-docker:build-<number>

# Required: replace with 8 random ASCII letters/digits. Never use a shared password.
VNC_PASSWORD=
BIND_IP=127.0.0.1
WEB_PORT=1150
TZ=Asia/Shanghai
AUTO_START=true
DISPLAY_WIDTH=1600
DISPLAY_HEIGHT=900
SHM_SIZE=1gb
MEM_LIMIT=4g
CPU_LIMIT=2.0

# Create these directories before running Compose. Absolute host paths are allowed.
PROFILE_DIR=./data/profile
DOWNLOAD_DIR=./data/downloads

# Recommended login: scan the QR code in 115 Browser. Optional cookie injection:
ENABLE_COOKIE_EXTENSION=false
COOKIE_CID=
COOKIE_SEID=
COOKIE_UID=
COOKIE_KID=
