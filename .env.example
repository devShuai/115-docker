# Leave IMAGE_115 unset: compose.yaml builds locally; compose.registry.yaml uses latest.
# Optional explicit production tag:
# IMAGE_115=registry.devshuai.com/shuai-repo/115-docker:latest
# For rollback, pin a previously verified build:
# IMAGE_115=registry.devshuai.com/shuai-repo/115-docker:build-<number>

# KasmVNC: 8-128 ASCII letters/digits. Use exactly 8 to also support legacy rollback.
VNC_PASSWORD=
REMOTE_BACKEND=kasm
REMOTE_USER=115
VNC_FPS=30
KASM_THREADS=2
# Software encoding: 0 switches quickly from WebP to faster JPEG.
# Increase toward 30 if bandwidth matters more than CPU on your host.
KASM_WEBP_BUDGET=0
BIND_IP=127.0.0.1
WEB_PORT=1150
# IANA time zone name. Empty or unset also means Asia/Shanghai.
TZ=Asia/Shanghai
AUTO_START=true
DISPLAY_WIDTH=1600
DISPLAY_HEIGHT=900
SHM_SIZE=1gb
MEM_LIMIT=4g
CPU_LIMIT=2.0

# Create these directories before running Compose. Absolute host paths are allowed.
PROFILE_DIR=./data/profile
DOWNLOAD_DIR=./data/downloads

# Recommended login: scan the QR code in 115 Browser. Optional cookie injection:
ENABLE_COOKIE_EXTENSION=false
COOKIE_CID=
COOKIE_SEID=
COOKIE_UID=
COOKIE_KID=
