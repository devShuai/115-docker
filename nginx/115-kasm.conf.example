# Default KasmVNC backend. Include in nginx.conf's http {} context.
# Native KasmVNC Basic authentication protects both HTTP and WebSocket requests.
map $http_upgrade $connection_upgrade_115_kasm {
    default upgrade;
    '' close;
}
server {
    listen 80;
    server_name 115.example.com;
    return 301 https://115.example.com$request_uri;
}
server {
    listen 443 ssl;
    server_name 115.example.com;
    ssl_certificate /etc/letsencrypt/live/115.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/115.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    location / {
        add_header Cache-Control "no-cache" always;
        proxy_pass http://127.0.0.1:1150;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade_115_kasm;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
}
